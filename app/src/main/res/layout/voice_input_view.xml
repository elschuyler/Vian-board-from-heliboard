<helium314.keyboard.latin.voice.VoiceInputView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voice_input_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:visibility="gone"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- Top Text Preview & Sensitivity Row -->
    <LinearLayout
        android:id="@+id/voice_top_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/voice_streaming_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical|start"
            android:text="@string/voice_status_listening"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:padding="4dp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/voice_gain_pill"
            android:layout_width="wrap_content"
            android:minWidth="38dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="1x"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_marginStart="6dp"
            android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>

    <!-- Middle Sound Waveform & Mic Button Row -->
    <LinearLayout
        android:id="@+id/voice_middle_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <!-- Sound Bar / Wave stretched almost all the way to right -->
        <helium314.keyboard.latin.voice.VoicePulseView
            android:id="@+id/voice_pulse_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp" />

        <!-- Only button: Mic. There. -->
        <ImageView
            android:id="@+id/voice_mic_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/sym_keyboard_voice_rounded"
            android:contentDescription="@string/voice_status_listening"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

    <!-- Bottom 4-Button Keyboard Row matching Clipboard & Main Keyboard -->
    <helium314.keyboard.keyboard.MainKeyboardView
        android:id="@+id/bottom_row_keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</helium314.keyboard.latin.voice.VoiceInputView>
