<helium314.keyboard.security.vault.ui.SecurityVaultExplorerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/security_vault_explorer_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:visibility="gone"
    android:background="@android:color/transparent"
    style="?attr/clipboardHistoryViewStyle">

    <!-- Top Navigation & Controls Header Strip -->
    <LinearLayout
        android:id="@+id/vault_top_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- Scrollable Category / Filter Pills -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/chip_filter_all"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginEnd="6dp"
                    android:text="All"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_vault_chip_active" />

                <TextView
                    android:id="@+id/chip_filter_recent"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginEnd="6dp"
                    android:text="Recent"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_vault_chip_inactive" />

                <TextView
                    android:id="@+id/chip_filter_folders"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginEnd="8dp"
                    android:text="Folders"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_vault_chip_inactive" />

                <ImageButton
                    android:id="@+id/btn_sort_toggle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sort_alphabetically"
                    android:contentDescription="Sort order toggle"
                    android:background="@drawable/bg_vault_circle_button" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Session Countdown Timer Pill -->
        <LinearLayout
            android:id="@+id/vault_timer_container"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/bg_vault_chip_inactive">

            <ImageView
                android:id="@+id/img_timer_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_timer"
                android:contentDescription="Session Timer" />

            <TextView
                android:id="@+id/txt_session_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="03:00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#EEFFFFFF" />
        </LinearLayout>

        <!-- Top Right Action Cluster: Unified Close & Lock -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_vault_lock"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_lock"
                android:contentDescription="Close &amp; Lock Vault"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

            <ImageButton
                android:id="@+id/btn_vault_close"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close_rounded"
                android:contentDescription="Close &amp; Lock Vault"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/vault_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22888888" />

    <!-- Items List (Accordion Folders and Entries) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_vault_items"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/txt_vault_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No credentials found in Security Vault"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

</helium314.keyboard.security.vault.ui.SecurityVaultExplorerView>
