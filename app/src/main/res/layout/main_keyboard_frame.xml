<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical" >

    <include
        android:id="@+id/strip_container"
        layout="@layout/strip_container" />

    <!-- To ensure that key preview popup is correctly placed when the current system locale is
         one of RTL locales, layoutDirection="ltr" is needed in the SDK version 17+. -->
    <helium314.keyboard.latin.KeyboardWrapperView
        android:id="@+id/keyboard_view_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr" >

        <helium314.keyboard.keyboard.MainKeyboardView
            android:id="@+id/keyboard_view"
            android:layoutDirection="ltr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <include
            android:id="@+id/emoji_palettes_view"
            layout="@layout/emoji_palettes_view" />
        <include
            android:id="@+id/clipboard_history_view"
            layout="@layout/clipboard_history_view" />
        <include
            android:id="@+id/desktop_shortcuts_view"
            layout="@layout/desktop_shortcuts_view" />
        <ViewStub
            android:id="@+id/pattern_unlock_view_stub"
            android:inflatedId="@+id/pattern_unlock_view"
            android:layout="@layout/pattern_unlock_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <ViewStub
            android:id="@+id/security_vault_explorer_view_stub"
            android:inflatedId="@+id/security_vault_explorer_view"
            android:layout="@layout/security_vault_explorer_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <ViewStub
            android:id="@+id/chosen_entry_view_stub"
            android:inflatedId="@+id/chosen_entry_view"
            android:layout="@layout/chosen_entry_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <ViewStub
            android:id="@+id/voice_input_view_stub"
            android:inflatedId="@+id/voice_input_view"
            android:layout="@layout/voice_input_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ImageButton
            android:id="@+id/btn_stop_one_handed_mode"
            android:contentDescription="@string/label_stop_onehanded_mode_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />

        <ImageButton
            android:id="@+id/btn_switch_one_handed_mode"
            android:contentDescription="@string/label_switch_onehanded_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />

        <ImageButton
            android:id="@+id/btn_resize_one_handed_mode"
            android:contentDescription="@string/label_resize_onehanded_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />

        <ImageView
            android:id="@+id/backgroundGatheringIndicator"
            android:visibility="visible"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/btn_keyboard_key_action_normal_lxx_base"
            android:tint="#a00000"
            android:layout_gravity="top"
            />
    </helium314.keyboard.latin.KeyboardWrapperView>
    <LinearLayout
        android:id="@+id/float_handle_container"
        android:orientation="horizontal"
        android:visibility="gone"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/close_floating_handle"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="@dimen/config_floating_handle_height"
            android:src="@drawable/ic_close_rounded"
            android:contentDescription="Close floating keyboard"
            android:scaleType="centerInside"
            android:padding="6dp" />
        <ImageView
            android:id="@+id/minimize_floating_handle"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="@dimen/config_floating_handle_height"
            android:src="@drawable/ic_floating_minimize"
            android:contentDescription="Minimize floating keyboard"
            android:scaleType="centerInside"
            android:padding="6dp" />
        <ImageView
            android:id="@+id/resize_handle"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="@dimen/config_floating_handle_height"
            android:src="@drawable/ic_arrow_horizontal"
            android:contentDescription="Resize floating keyboard"
            android:scaleType="centerInside"
            android:padding="6dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/floating_folded_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:visibility="gone"
        android:background="@drawable/bg_floating_folded_bubble"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/floating_folded_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Unfold floating keyboard" />
    </FrameLayout>
</LinearLayout>
