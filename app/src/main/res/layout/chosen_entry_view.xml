<helium314.keyboard.security.vault.ui.ChosenEntryView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chosen_entry_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:visibility="gone"
    android:background="@android:color/transparent"
    style="?attr/clipboardHistoryViewStyle">

    <!-- Row 1 (Top Header Row): Back & Lock, Title & Subtitle -->
    <LinearLayout
        android:id="@+id/chosen_top_row"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_chosen_back"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back to Vault Explorer"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

            <ImageButton
                android:id="@+id/btn_chosen_lock"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_lock"
                android:contentDescription="Close &amp; Lock Vault"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_chosen_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txt_chosen_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Session Countdown Timer Pill -->
        <LinearLayout
            android:id="@+id/chosen_timer_container"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:background="@drawable/bg_vault_chip_inactive">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_timer"
                android:contentDescription="Session Timer" />

            <TextView
                android:id="@+id/txt_chosen_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="03:00"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#EEFFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2 (Middle Action Row - 5 Action Tiles styled like keyboard keys) -->
    <!-- Order: Notes, Attachment, Password, Username, TOTP -->
    <LinearLayout
        android:id="@+id/chosen_action_row"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp">

        <!-- Tile 1: Note -->
        <LinearLayout
            android:id="@+id/btn_action_note"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="2dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_chosen_action_key">

            <ImageView
                android:id="@+id/icon_action_note"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_note"
                android:contentDescription="View Note" />

            <TextView
                android:id="@+id/label_action_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:text="Note" />
        </LinearLayout>

        <!-- Tile 2: Attachment -->
        <LinearLayout
            android:id="@+id/btn_action_attachment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="2dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_chosen_action_key">

            <ImageView
                android:id="@+id/icon_action_attachment"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_attachment"
                android:contentDescription="View Attachments" />

            <TextView
                android:id="@+id/label_action_attachment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:text="Files" />
        </LinearLayout>

        <!-- Tile 3: Password -->
        <LinearLayout
            android:id="@+id/btn_action_password"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="2dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_chosen_action_key">

            <ImageView
                android:id="@+id/icon_action_password"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_lock"
                android:contentDescription="Inject Password" />

            <TextView
                android:id="@+id/label_action_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textStyle="bold"
                android:text="Password" />
        </LinearLayout>

        <!-- Tile 4: Username -->
        <LinearLayout
            android:id="@+id/btn_action_username"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="2dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_chosen_action_key">

            <ImageView
                android:id="@+id/icon_action_username"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_vpn_key"
                android:contentDescription="Inject Username" />

            <TextView
                android:id="@+id/label_action_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textStyle="bold"
                android:text="User" />
        </LinearLayout>

        <!-- Tile 5: TOTP with live progress -->
        <LinearLayout
            android:id="@+id/btn_action_totp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="2dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_chosen_action_key">

            <helium314.keyboard.security.vault.ui.TotpCircleProgressView
                android:id="@+id/action_totp_circle"
                android:layout_width="18dp"
                android:layout_height="18dp" />

            <TextView
                android:id="@+id/label_action_totp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textStyle="bold"
                android:text="TOTP" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3 (Bottom Utility Row Keyboard: ABC, Space, Delete, Enter) -->
    <helium314.keyboard.keyboard.MainKeyboardView
        android:id="@+id/bottom_row_keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</helium314.keyboard.security.vault.ui.ChosenEntryView>
