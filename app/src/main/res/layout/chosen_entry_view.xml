<helium314.keyboard.security.vault.ui.ChosenEntryView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chosen_entry_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- Row 3 (Top Row): Lock & Back on Left, Title & Username on Right -->
    <LinearLayout
        android:id="@+id/chosen_top_row"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <!-- Stacked tiny buttons: Lock on left, Back on right (or stacked) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_chosen_back"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back to Vault Explorer"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

            <ImageButton
                android:id="@+id/btn_chosen_lock"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_lock"
                android:contentDescription="Close &amp; Lock Vault"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_chosen_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txt_chosen_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2 (Middle Action Row - 5 Action Tiles) -->
    <LinearLayout
        android:id="@+id/chosen_action_row"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- Tile 1: Note -->
        <LinearLayout
            android:id="@+id/btn_action_note"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="2dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/icon_action_note"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_note"
                android:contentDescription="View Note" />

            <TextView
                android:id="@+id/label_action_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:text="Note" />
        </LinearLayout>

        <!-- Tile 2: Username -->
        <LinearLayout
            android:id="@+id/btn_action_username"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="2dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/icon_action_username"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_vpn_key"
                android:contentDescription="Inject Username" />

            <TextView
                android:id="@+id/label_action_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textStyle="bold"
                android:text="User" />
        </LinearLayout>

        <!-- Tile 3: Password -->
        <LinearLayout
            android:id="@+id/btn_action_password"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="2dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/icon_action_password"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_lock"
                android:contentDescription="Inject Password" />

            <TextView
                android:id="@+id/label_action_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textStyle="bold"
                android:text="Password" />
        </LinearLayout>

        <!-- Tile 4: TOTP with live progress -->
        <LinearLayout
            android:id="@+id/btn_action_totp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="2dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <helium314.keyboard.security.vault.ui.TotpCircleProgressView
                android:id="@+id/action_totp_circle"
                android:layout_width="20dp"
                android:layout_height="20dp" />

            <TextView
                android:id="@+id/label_action_totp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:text="TOTP" />
        </LinearLayout>

        <!-- Tile 5: Attachment -->
        <LinearLayout
            android:id="@+id/btn_action_attachment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="2dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/icon_action_attachment"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_attachment"
                android:contentDescription="View Attachments" />

            <TextView
                android:id="@+id/label_action_attachment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:text="Files" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 1 (Bottom Utility Row: ABC, Space, Backspace, Enter/Next) -->
    <LinearLayout
        android:id="@+id/chosen_bottom_row"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <Button
            android:id="@+id/btn_util_abc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:text="ABC"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_margin="2dp"
            android:background="?android:attr/selectableItemBackground" />

        <Button
            android:id="@+id/btn_util_space"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2.2"
            android:text="Space"
            android:textSize="12sp"
            android:layout_margin="2dp"
            android:background="?android:attr/selectableItemBackground" />

        <ImageButton
            android:id="@+id/btn_util_backspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/sym_keyboard_delete_rounded"
            android:scaleType="centerInside"
            android:contentDescription="Backspace"
            android:layout_margin="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <ImageButton
            android:id="@+id/btn_util_enter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/sym_keyboard_return_rounded"
            android:scaleType="centerInside"
            android:contentDescription="Enter or Next"
            android:layout_margin="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
</helium314.keyboard.security.vault.ui.ChosenEntryView>
